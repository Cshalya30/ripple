# Copy to .env for local runs. Never commit .env.

# AI provider (optional). Without a key, set-up needs reviewed facts and Munim answers from templates.
SNAPSHOT_EXTRACTOR=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ASSISTANT_MODEL=openai/gpt-oss-120b

# SQLite file; mount a persistent volume at /data in production.
DATABASE_URL=/data/ripple.db

# Password for the three shared demo accounts (owner@, accountant@, supervisor@ripple.demo).
DEMO_PASSWORD=ripple-demo-2026

# Only when the frontend is hosted on another origin.
ALLOWED_ORIGINS=

# auto (secure behind HTTPS), true or false.
COOKIE_SECURE=auto

# Risk engine sample counts and worker processes (0 = run in the API process).
RISK_SAMPLES=200
RISK_DRIVER_SAMPLES=30
RISK_FIX_SAMPLES=100
RISK_PROCESSES=1

# Demo copies created by "Open demo business" (deleted after 24 hours).
MAX_SANDBOXES=400

# Optional: pin "today" for rehearsals, e.g. 2026-10-14.
RIPPLE_TODAY=
