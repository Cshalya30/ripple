# Copy to .env for local runs. Never commit .env.

# AI provider (optional). Without a key, set-up needs reviewed facts and Munim answers from templates.
SNAPSHOT_EXTRACTOR=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ASSISTANT_MODEL=openai/gpt-oss-120b

# SQLite file; mount a persistent volume at /data in production.
DATABASE_URL=/data/ripple.db

# Password for the three shared demo accounts (owner@, accountant@, supervisor@ripple.demo).
DEMO_PASSWORD=ripple-demo-2026

# Only when the frontend is hosted on another origin.
ALLOWED_ORIGINS=

# auto (secure behind HTTPS), true or false.
COOKIE_SECURE=auto

# Risk engine sample counts and worker processes (0 = run in the API process).
RISK_SAMPLES=200
RISK_DRIVER_SAMPLES=30
RISK_FIX_SAMPLES=100
RISK_PROCESSES=1

# Demo copies created by "Open demo business" (deleted after 24 hours).
MAX_SANDBOXES=400

# Optional: pin "today" for rehearsals, e.g. 2026-10-14.
RIPPLE_TODAY=

# Rate limits count the client address. Behind a proxy (Railway, a load balancer) keep TRUST_PROXY=1 and set TRUSTED_PROXY_HOPS to the
# number of proxies in front of the app: the address the LAST of them recorded is used, never the left-hand entries a client can forge.
# Not behind a proxy: set TRUST_PROXY=0.
TRUST_PROXY=1
TRUSTED_PROXY_HOPS=1

# The site's own address (no trailing slash). Used for the share image and the sitemap, and as the base of the
# Bolna webhook URL below. Empty = use the address each request came to for the sitemap; Ripple Voice needs it set.
PUBLIC_BASE_URL=

# Ripple Voice (Bolna Buildathon add-on; see PLAN_VOICE.md). Without BOLNA_API_KEY and BOLNA_AGENT_ID,
# "Call customer" still previews but a real call cannot be placed.
BOLNA_API_KEY=
# "bearer" sends "Authorization: Bearer <key>"; some Bolna docs show the raw key instead — set to "raw" if so.
BOLNA_AUTH_SCHEME=bearer
# From `python -m scripts.bolna_setup` (or bolna/DASHBOARD_SETUP.md for the manual fallback).
BOLNA_AGENT_ID=
# A random secret; put the same value in the agent's webhook URL (?token=...). Required for the webhook to accept anything.
BOLNA_WEBHOOK_SECRET=
# When set, every Ripple Voice call dials this number instead of the customer's own (demos, testing). Shows a
# "Demo mode" badge in the UI. Leave empty for real calls.
DEMO_PHONE_OVERRIDE=
# Calls are only placed in this window, Asia/Kolkata, 24h clock.
CALL_WINDOW_START=9
CALL_WINDOW_END=19
# true: also check the webhook's source IP against Bolna's documented addresses. false (default): token only.
BOLNA_IP_ALLOWLIST=false
