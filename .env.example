# Copy to .env (repository root) and fill in. Never commit the real .env.

# Gemini key for the "Ask Ripple" assistant. Without it the assistant uses built-in replies.
GOOGLE_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=700

# Whisper model for voice (only used if requirements-voice.txt is installed): tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base

# Where the khata database lives (SQLite). Default: backend/data/ripple.db
RIPPLE_DB_PATH=backend/data/ripple.db

# Browser origins allowed to call the API when the frontend runs separately (comma separated).
RIPPLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business "today" is calculated in this timezone.
RIPPLE_TIMEZONE=Asia/Kolkata
