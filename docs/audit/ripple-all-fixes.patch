+    req("who am I", "GET", "/api/me", status(200) + js("const me = pm.response.json();",
+        "pm.test('owner role', () => pm.expect(me.user.role).to.eql('OWNER'));",
+        "pm.collectionVariables.set('my_user_id', me.user.id);",
