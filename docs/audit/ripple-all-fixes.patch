+++ b/e2e/audit-a11y.mjs
@@ -0,0 +1,130 @@
+// Track B accessibility, layout and page-basics audit.
+// Usage: RIPPLE_URL=http://localhost:8766 node audit-a11y.mjs <outDir>
+//  1. axe-core (WCAG 2.0/2.1 A and AA, incl. colour contrast) on every route in the three themes and in high-contrast
+//  2. horizontal overflow and small tap targets at 360, 390 and 768 px
+//  3. page titles, meta tags, favicon links resolving, robots and sitemap
+import { chromium } from 'playwright-core'
+import fs from 'node:fs'
+import { createRequire } from 'node:module'
+
+const require = createRequire(import.meta.url)
+const axeSource = fs.readFileSync(require.resolve('axe-core/axe.min.js'), 'utf8')
+const BASE = process.env.RIPPLE_URL || 'http://localhost:8000'
+const OUT = process.argv[2] || 'audit-out'
+fs.mkdirSync(OUT, { recursive: true })
+
+const browser = await chromium.launch({ executablePath: process.env.BROWSER_PATH || 'C:/Program Files/Google/Chrome/Application/chrome.exe', headless: true })
+const ctx = await browser.newContext({ viewport: { width: 1440, height: 900 }, bypassCSP: true }) // CSP blocks the injected axe script; the page itself is unchanged
+const page = await ctx.newPage()
+
+const PUBLIC = [['login', '/login'], ['privacy', '/privacy'], ['terms', '/terms'], ['notfound', '/nope'], ['setup', '/setup']]
+const APP = [['today', '/app/today'], ['engine', '/app/engine'], ['book', '/app/book'], ['book-risk', '/app/book?tab=risk'], ['book-ledger', '/app/book?tab=ledger'],
+  ['khata', '/app/khata'], ['orders', '/app/orders'], ['orders-purchase', '/app/orders?tab=purchase'], ['orders-whatif', '/app/orders?tab=new'],
+  ['inventory', '/app/inventory'], ['settings', '/app/settings']]
+const THEMES = [['night', 'normal'], ['day', 'normal'], ['lamp', 'normal'], ['night', 'high'], ['day', 'high']]
+const WIDTHS = [360, 390, 768]
+const TITLES = { '/login': 'Sign in · Ripple', '/privacy': 'Privacy · Ripple', '/terms': 'Terms of use · Ripple', '/nope': 'Page not found · Ripple', '/setup': 'Set up your business · Ripple',
+  '/app/today': 'Today · Ripple', '/app/engine': 'Engine · Ripple', '/app/book': 'Book · Ripple', '/app/khata': 'Khata · Ripple', '/app/orders': 'Orders · Ripple', '/app/inventory': 'Inventory · Ripple', '/app/settings': 'Settings · Ripple' }
+
+const settle = async () => { await page.waitForLoadState('networkidle', { timeout: 8000 }).catch(() => {}); await page.waitForTimeout(600) }
+const result = { base: BASE, axe: [], layout: [], basics: [] }
+
+async function login() {
+  await page.goto(`${BASE}/login`)
+  await page.getByRole('button', { name: /Open demo business/ }).click()
+  await page.waitForSelector('text=Do today', { timeout: 20000 })
+}
+
+async function scan(name, path, theme, contrast) {
+  await page.goto(`${BASE}${path}`)
+  await settle()
+  await page.evaluate(([t, c]) => { document.documentElement.setAttribute('data-theme', t); document.documentElement.setAttribute('data-contrast', c) }, [theme, contrast])
+  await page.waitForTimeout(250)
+  await page.evaluate((src) => { if (!window.axe) { const s = document.createElement('script'); s.textContent = src; document.head.appendChild(s) } }, axeSource)
+  const r = await page.evaluate(async () => {
+    const out = await window.axe.run(document, { runOnly: { type: 'tag', values: ['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa'] }, resultTypes: ['violations'] })
+    return out.violations.map((v) => ({ id: v.id, impact: v.impact, help: v.help, count: v.nodes.length,
+      samples: v.nodes.slice(0, 4).map((n) => ({ target: n.target.join(' '), summary: (n.failureSummary || '').split('\n').slice(1, 3).join(' ').slice(0, 220), html: n.html.slice(0, 120) })) }))
+  })
+  result.axe.push({ route: name, path, theme, contrast, violations: r })
+  return r
+}
+
+async function layout(name, path, width) {
+  await page.setViewportSize({ width, height: 800 })
+  await page.goto(`${BASE}${path}`)
+  await settle()
+  const r = await page.evaluate(() => {
+    const doc = document.documentElement
+    const overflow = doc.scrollWidth - doc.clientWidth
+    const wide = [...document.querySelectorAll('body *')].filter((el) => {
+      const b = el.getBoundingClientRect()
+      return b.width > 0 && b.right > doc.clientWidth + 1 && !el.closest('.table-wrap, [style*="overflow"], .scroll-x, svg, .tabs')
+    }).slice(0, 5).map((el) => `${el.tagName.toLowerCase()}.${String(el.className).slice(0, 30)}`)
+    const small = [...document.querySelectorAll('button, a[href], [role="tab"], input:not([type="hidden"]), select')].filter((el) => {
+      const b = el.getBoundingClientRect(); const cs = getComputedStyle(el)
+      return b.width > 0 && b.height > 0 && cs.visibility !== 'hidden' && (b.height < 44 || b.width < 44) && !(el.tagName === 'A' && el.closest('p, li, td, .small, .micro'))
+    })
+    return { overflow, wide, small_targets: small.length, small_sample: small.slice(0, 5).map((el) => `${el.tagName.toLowerCase()}:${(el.getAttribute('aria-label') || el.textContent || '').trim().slice(0, 24)}:${Math.round(el.getBoundingClientRect().width)}x${Math.round(el.getBoundingClientRect().height)}`) }
+  })
+  result.layout.push({ route: name, path, width, ...r })
+}
+
+// ---- public pages (not signed in)
+for (const [name, path] of PUBLIC) {
+  for (const [theme, contrast] of THEMES) await scan(name, path, theme, contrast)
+  for (const w of WIDTHS) await layout(name, path, w)
+  await page.setViewportSize({ width: 1440, height: 900 })
+  await page.goto(`${BASE}${path}`); await settle()
+  result.basics.push({ check: 'title', path, expected: TITLES[path], actual: await page.title(), pass: (await page.title()) === TITLES[path] })
+}
+// ---- signed in
+await login()
+for (const [name, path] of APP) {
+  await page.setViewportSize({ width: 1440, height: 900 })
+  for (const [theme, contrast] of THEMES) await scan(name, path, theme, contrast)
+  for (const w of WIDTHS) await layout(name, path, w)
+  await page.setViewportSize({ width: 1440, height: 900 })
+  await page.goto(`${BASE}${path}`); await settle()
+  const base = path.split('?')[0]
+  result.basics.push({ check: 'title', path, expected: TITLES[base], actual: await page.title(), pass: (await page.title()) === TITLES[base] })
+}
+// ---- an unknown page inside the app
+await page.goto(`${BASE}/app/zzz`); await settle()
+result.basics.push({ check: 'in-app 404 shows the page and keeps the sidebar', pass: (await page.locator('text=This page does not exist').count()) === 1 && (await page.locator('nav, aside').count()) > 0 })
+
+// ---- head tags, icons, robots, sitemap
+await page.goto(`${BASE}/app/today`); await settle()
+const head = await page.evaluate(() => ({
+  description: document.querySelector('meta[name="description"]')?.content, ogTitle: document.querySelector('meta[property="og:title"]')?.content,
+  ogImage: document.querySelector('meta[property="og:image"]')?.content, twitter: document.querySelector('meta[name="twitter:card"]')?.content,
+  icons: [...document.querySelectorAll('link[rel*="icon"]')].map((l) => l.getAttribute('href')), lang: document.documentElement.lang,
+  imgs: [...document.querySelectorAll('img')].map((i) => ({ src: i.src, alt: i.getAttribute('alt') })),
+}))
+result.basics.push({ check: 'head tags', ...head, pass: !!(head.description && head.ogTitle && head.ogImage && head.twitter && head.icons.every((h) => h.startsWith('/'))) })
+for (const href of [...head.icons, '/og-image.png', '/robots.txt', '/sitemap.xml']) {
+  const r = await page.request.get(`${BASE}${href}`)
+  const type = r.headers()['content-type']
+  result.basics.push({ check: `GET ${href}`, status: r.status(), type, bytes: (await r.body()).length, pass: r.status() === 200 && !/html/.test(type || '') })
+}
+const robots = await (await page.request.get(`${BASE}/robots.txt`)).text()
+const sitemap = await (await page.request.get(`${BASE}/sitemap.xml`)).text()
+result.basics.push({ check: 'robots disallows /app/ and /api/', pass: /Disallow: \/app\//.test(robots) && /Disallow: \/api\//.test(robots) })
+result.basics.push({ check: 'sitemap lists only public pages', pass: /\/login/.test(sitemap) && /\/privacy/.test(sitemap) && /\/terms/.test(sitemap) && !/\/app\//.test(sitemap) })
+for (const [path, want] of [['/nope', 404], ['/app/zzz', 404], ['/.env', 404], ['/assets/missing.js', 404], ['/login', 200], ['/app/today', 200], ['/api/nope', 404]]) {
+  const r = await page.request.get(`${BASE}${path}`)
+  result.basics.push({ check: `status of ${path}`, status: r.status(), pass: r.status() === want })
+}
+
+const axeBad = result.axe.flatMap((a) => a.violations.map((v) => ({ route: a.route, theme: `${a.theme}/${a.contrast}`, ...v })))
+const summary = {
+  axe_scans: result.axe.length,
+  axe_violation_groups: axeBad.length,
+  axe_by_rule: axeBad.reduce((m, v) => { m[v.id] = (m[v.id] || 0) + 1; return m }, {}),
+  layout_checks: result.layout.length,
+  horizontal_overflow: result.layout.filter((l) => l.overflow > 0).map((l) => `${l.route}@${l.width}: +${l.overflow}px`),
+  basics_failed: result.basics.filter((b) => !b.pass).map((b) => b.check + (b.path ? ` ${b.path}` : '')),
+}
+fs.writeFileSync(`${OUT}/a11y-layout-basics.json`, JSON.stringify({ summary, ...result }, null, 1))
+console.log(JSON.stringify(summary, null, 1))
+await browser.close()
diff --git a/e2e/audit-controls.mjs b/e2e/audit-controls.mjs
new file mode 100644
index 00000000..44c32a6d
--- /dev/null
+++ b/e2e/audit-controls.mjs
@@ -0,0 +1,157 @@
+// Track A control sweep: opens each route, lists every interactive control, clicks each one on a fresh page,
+// and records what happened (requests, console/page errors, dialogs, URL and DOM change).
+// Usage: RIPPLE_URL=http://localhost:8766 node audit-controls.mjs <outDir> [routeFilter]
+import { chromium } from 'playwright-core'
+import fs from 'node:fs'
+
+const BASE = process.env.RIPPLE_URL || 'http://localhost:8000'
+const OUT = process.argv[2] || 'audit-out'
+const FILTER = process.argv[3]
+const WIDTH = Number(process.env.W || 1440), HEIGHT = Number(process.env.H || 900)
+fs.mkdirSync(OUT, { recursive: true })
+
+const browser = await chromium.launch({ executablePath: process.env.BROWSER_PATH || 'C:/Program Files/Google/Chrome/Application/chrome.exe', headless: true })
+const ctx = await browser.newContext({ viewport: { width: WIDTH, height: HEIGHT }, acceptDownloads: true })
+const page = await ctx.newPage()
+
+let log = []
+page.on('console', (m) => { if (['error', 'warning'].includes(m.type())) log.push({ t: 'console', level: m.type(), text: m.text().slice(0, 240) }) })
+page.on('pageerror', (e) => log.push({ t: 'pageerror', text: e.message.slice(0, 240) }))
+page.on('requestfailed', (r) => log.push({ t: 'requestfailed', url: r.url().replace(BASE, ''), error: r.failure()?.errorText }))
+page.on('response', (r) => {
+  const url = r.url().replace(BASE, '')
+  if (url.startsWith('/api/')) log.push({ t: 'api', method: r.request().method(), url: url.split('?')[0], status: r.status() })
+  else if (r.status() >= 400) log.push({ t: 'asset', url, status: r.status() })
+})
+
+const BAD_TEXT = /Internal Server Error|Traceback|Exception|Network Error|Request failed|\[object Object\]|\bundefined\b|\bNaN\b|\bsqlite3\b/
+const SKIP = /log ?out|sign out|reset|delete|remove|load demo|erase/i
+const CONTROLS = 'button, a[href], [role="tab"], [role="checkbox"], select, input:not([type="hidden"]), textarea, .pnode, .enode, tr.clickable, [role="button"]'
+
+async function login() {
+  await page.goto(`${BASE}/login`)
+  await page.getByRole('button', { name: /Open demo business/ }).click()
+  await page.waitForSelector('text=Do today', { timeout: 20000 })
+}
+
+async function describe(i) {
+  return page.locator(CONTROLS).nth(i).evaluate((el) => {
+    const r = el.getBoundingClientRect()
+    const visible = r.width > 0 && r.height > 0 && getComputedStyle(el).visibility !== 'hidden'
+    const name = (el.getAttribute('aria-label') || el.innerText || el.getAttribute('title') || el.getAttribute('placeholder') || el.getAttribute('name') || '').replace(/\s+/g, ' ').trim().slice(0, 70)
+    return { tag: el.tagName.toLowerCase(), role: el.getAttribute('role') || (el.tagName === 'A' ? 'link' : el.tagName === 'BUTTON' ? 'button' : el.tagName.toLowerCase()), type: el.getAttribute('type'),
+      name, href: el.getAttribute('href'), disabled: el.disabled === true || el.getAttribute('aria-disabled') === 'true', visible, cls: String(el.className || '').slice(0, 40) }
+  })
+}
+
+async function openDetails() { await page.evaluate(() => document.querySelectorAll('details').forEach((d) => { d.open = true })) }
+
+async function settle() { await page.waitForLoadState('networkidle', { timeout: 6000 }).catch(() => {}); await page.waitForTimeout(350) }
+
+const ROUTES = [
+  { id: 'today', path: '/app/today', ready: 'text=Do today' },
+  { id: 'engine-network', path: '/app/engine', ready: '.pnode', pre: null },
+  { id: 'engine-flow', path: '/app/engine', ready: '.pnode', pre: async () => { await page.getByRole('tab', { name: 'flow' }).click(); await page.waitForSelector('.enode', { timeout: 15000 }) } },
+  { id: 'engine-decisions', path: '/app/engine', ready: '.pnode', pre: async () => { await page.getByRole('tab', { name: 'decisions' }).click(); await page.waitForTimeout(800) } },
+  { id: 'engine-table', path: '/app/engine', ready: '.pnode', pre: async () => { await page.getByRole('tab', { name: 'flow' }).click(); await page.getByRole('button', { name: 'Table' }).click(); await page.waitForTimeout(800) } },
+  { id: 'book-position', path: '/app/book', ready: 'text=Runway' },
+  { id: 'book-risk', path: '/app/book?tab=risk', ready: '.gp', pre: async () => { await page.waitForSelector('.f-median', { timeout: 40000 }).catch(() => {}) } },
+  { id: 'book-ledger', path: '/app/book?tab=ledger', ready: 'text=Ledger' },
+  // Track B screens
+  { id: 'login', path: '/login', ready: 'text=Sign in', public: true },
+  { id: 'privacy', path: '/privacy', ready: 'text=What Ripple stores', public: true },
+  { id: 'terms', path: '/terms', ready: 'text=Demo and synthetic data', public: true },
+  { id: 'notfound', path: '/no-such-page', ready: 'text=This page does not exist', public: true },
+  { id: 'setup', path: '/setup', ready: 'textarea', public: true },
+  { id: 'khata', path: '/app/khata', ready: '.page' },
+  { id: 'orders-sales', path: '/app/orders', ready: '.tabs' },
+  { id: 'orders-purchase', path: '/app/orders?tab=purchase', ready: '.tabs' },
+  { id: 'orders-whatif', path: '/app/orders?tab=new', ready: '.tabs' },
+  { id: 'inventory-raw', path: '/app/inventory', ready: '.tabs' },
+  { id: 'inventory-finished', path: '/app/inventory', ready: '.tabs', pre: async () => { await page.getByRole('tab', { name: /finished/i }).click() } },
+  { id: 'inventory-recipes', path: '/app/inventory', ready: '.tabs', pre: async () => { await page.getByRole('tab', { name: /recipes/i }).click() } },
+  { id: 'inventory-movements', path: '/app/inventory', ready: '.tabs', pre: async () => { await page.getByRole('tab', { name: /movements/i }).click() } },
+  { id: 'settings', path: '/app/settings', ready: '.page' },
+].filter((r) => !FILTER || FILTER.split(',').some((f) => r.id === f || r.id.startsWith(f + '-')))
+
+async function open(route) {
+  await page.goto(`${BASE}${route.path}`)
+  await page.waitForSelector(route.ready, { timeout: 25000 }).catch(() => log.push({ t: 'blocked', text: `ready selector ${route.ready} not found` }))
+  if (route.pre) await route.pre().catch((e) => log.push({ t: 'blocked', text: 'pre-step failed: ' + e.message.split('\n')[0] }))
+  await settle()
+  await openDetails()
+}
+
+const results = []
+if (ROUTES.some((r) => !r.public)) await login()
+
+for (const route of ROUTES) {
+  log = []
+  await open(route)
+  const count = await page.locator(CONTROLS).count()
+  const inventory = []
+  for (let i = 0; i < count; i++) inventory.push({ i, ...(await describe(i)) })
+  const pageText = await page.locator('body').innerText()
+  const badText = pageText.match(BAD_TEXT)
+  console.log(`${route.id}: ${count} controls; load log entries ${log.length}; bad text: ${badText ? badText[0] : 'none'}`)
+  const loadIssues = log.filter((l) => l.t === 'console' || l.t === 'pageerror' || l.t === 'requestfailed' || l.t === 'asset' || (l.t === 'api' && l.status >= 400) || l.t === 'blocked')
+  results.push({ route: route.id, path: route.path, kind: 'page-load', controls: count, issues: loadIssues, bad_text: badText ? badText[0] : null })
+
+  for (const c of inventory) {
+    const rec = { route: route.id, index: c.i, tag: c.tag, role: c.role, name: c.name, href: c.href, type: c.type }
+    if (!c.visible) { rec.status = 'NOT APPLICABLE'; rec.note = 'not visible in this state'; results.push(rec); continue }
+    if (c.disabled) { rec.status = 'NOT APPLICABLE'; rec.note = 'disabled in this state'; results.push(rec); continue }
+    if (SKIP.test(c.name)) { rec.status = 'BLOCKED'; rec.note = 'destructive or session-ending control; covered by a targeted test on a throw-away business'; results.push(rec); continue }
+    if (c.href && /^https?:\/\//.test(c.href) && !c.href.startsWith(BASE)) { rec.status = 'BLOCKED'; rec.note = 'external link; checked for rel attributes only'; results.push(rec); continue }
+    log = []
+    await open(route)
+    const loc = page.locator(CONTROLS).nth(c.i)
+    const before = { url: page.url(), dom: await page.evaluate(() => document.body.innerHTML.length), dialogs: await page.locator('[role="dialog"], .drawer, [role="menu"], .popover').count() }
+    let action = 'click'
+    try {
+      if (c.tag === 'select') {
+        action = 'select 2nd option'
+        const options = await loc.locator('option').count()
+        if (options > 1) await loc.selectOption({ index: 1 }, { timeout: 3000 }); else action = 'select (single option)'
+      } else if (c.tag === 'input' && ['text', 'search', null, 'email', 'number'].includes(c.type)) {
+        action = 'type'
+        await loc.fill(c.type === 'number' ? '5' : 'audit', { timeout: 3000 })
+      } else if (c.tag === 'textarea') {
+        action = 'type'
+        await loc.fill('audit', { timeout: 3000 })
+      } else {
+        const download = page.waitForEvent('download', { timeout: 1500 }).catch(() => null)
+        await loc.click({ timeout: 3000, trial: false })
+        const d = await download
+        if (d) { rec.download = d.suggestedFilename(); log.push({ t: 'download', text: d.suggestedFilename() }) }
+      }
+    } catch (e) {
+      rec.status = 'FAIL'; rec.note = `${action} failed: ${e.message.split('\n')[0]}`; results.push(rec); continue
+    }
+    await settle()
+    const after = { url: page.url(), dom: await page.evaluate(() => document.body.innerHTML.length), dialogs: await page.locator('[role="dialog"], .drawer, [role="menu"], .popover').count() }
+    const text = await page.locator('body').innerText()
+    const bad = text.match(BAD_TEXT)
+    const api = log.filter((l) => l.t === 'api')
+    const errs = log.filter((l) => l.t === 'console' || l.t === 'pageerror' || l.t === 'requestfailed' || l.t === 'asset')
+    const apiBad = api.filter((a) => a.status >= 400)
+    rec.action = action
+    rec.requests = api.map((a) => `${a.method} ${a.url} ${a.status}`)
+    rec.effect = { url_changed: before.url !== after.url, dom_changed: before.dom !== after.dom, dialog_delta: after.dialogs - before.dialogs, requests: api.length, download: rec.download || null }
+    const observed = rec.effect.url_changed || rec.effect.dom_changed || rec.effect.dialog_delta !== 0 || api.length > 0 || rec.download
+    const problems = []
+    if (errs.length) problems.push(...errs.map((e) => `${e.t}: ${e.text || e.url}`))
+    if (apiBad.length) problems.push(...apiBad.map((a) => `HTTP ${a.status} ${a.method} ${a.url}`))
+    if (bad && !BAD_TEXT.test(pageText)) problems.push('bad text appeared: ' + bad[0])
+    if (!observed) problems.push('no observable effect (no URL, DOM, dialog, request or download change)')
+    rec.status = problems.length ? 'FAIL' : 'PASS'
+    if (problems.length) rec.problems = problems
+    results.push(rec)
+    if (problems.length) await page.screenshot({ path: `${OUT}/fail-${route.id}-${c.i}.png` }).catch(() => {})
+  }
+}
+
+const summary = results.filter((r) => r.kind !== 'page-load').reduce((a, r) => { a[r.status] = (a[r.status] || 0) + 1; return a }, {})
+fs.writeFileSync(`${OUT}/controls-${WIDTH}${FILTER ? '-' + FILTER : '-full'}.json`, JSON.stringify({ base: BASE, viewport: [WIDTH, HEIGHT], summary, results }, null, 1))
+console.log('SUMMARY', JSON.stringify(summary))
+await browser.close()
diff --git a/e2e/audit-keyboard.mjs b/e2e/audit-keyboard.mjs
new file mode 100644
index 00000000..718cdb0a
--- /dev/null
+++ b/e2e/audit-keyboard.mjs
@@ -0,0 +1,64 @@
+// Track B keyboard and reflow audit.
+// Usage: RIPPLE_URL=http://localhost:8769 node audit-keyboard.mjs <outDir>
+//  1. Tab through each route: every stop must be visible, have a name, and show a focus indicator
+//  2. Reflow: no horizontal scroll at 320 px (WCAG 1.4.10) and at 720 x 450 (what 200% zoom leaves on a 1440 px screen)
+import { chromium } from 'playwright-core'
+import fs from 'node:fs'
+
+const BASE = process.env.RIPPLE_URL || 'http://localhost:8000'
+const OUT = process.argv[2] || 'audit-out'
+fs.mkdirSync(OUT, { recursive: true })
+const browser = await chromium.launch({ executablePath: process.env.BROWSER_PATH || 'C:/Program Files/Google/Chrome/Application/chrome.exe', headless: true })
+const ctx = await browser.newContext({ viewport: { width: 1440, height: 900 } })
+const page = await ctx.newPage()
+const settle = async () => { await page.waitForLoadState('networkidle', { timeout: 8000 }).catch(() => {}); await page.waitForTimeout(500) }
+
+const PUBLIC = ['/login', '/privacy', '/terms', '/no-such-page']
+const APP = ['/app/today', '/app/engine', '/app/book', '/app/book?tab=ledger', '/app/khata', '/app/orders', '/app/orders?tab=purchase', '/app/orders?tab=new', '/app/inventory', '/app/settings']
+const out = { focus: [], reflow: [] }
+
+async function tabThrough(path) {
+  await page.goto(`${BASE}${path}`); await settle()
+  await page.evaluate(() => { document.activeElement?.blur?.(); window.scrollTo(0, 0) })
+  const stops = []
+  for (let i = 0; i < 45; i++) {
+    await page.keyboard.press('Tab')
+    const info = await page.evaluate(() => {
+      const el = document.activeElement
+      if (!el || el === document.body) return null
+      const cs = getComputedStyle(el), r = el.getBoundingClientRect()
+      const name = (el.getAttribute('aria-label') || el.labels?.[0]?.innerText || el.innerText || el.getAttribute('title') || el.getAttribute('placeholder') || el.getAttribute('name') || el.id || '').replace(/\s+/g, ' ').trim().slice(0, 40)
+      const outline = cs.outlineStyle !== 'none' && parseFloat(cs.outlineWidth) > 0
+      const shadow = cs.boxShadow && cs.boxShadow !== 'none'
+      return { tag: el.tagName.toLowerCase(), name, visible: r.width > 0 && r.height > 0, indicator: outline || !!shadow, inDialog: !!el.closest('[role="dialog"]') }
+    })
+    if (!info) break
+    stops.push(info)
+  }
+  const problems = stops.filter((s) => !s.visible || !s.name || !s.indicator)
+  out.focus.push({ path, stops: stops.length, problems: problems.map((p) => `${p.tag}:"${p.name}" visible=${p.visible} indicator=${p.indicator}`) })
+}
+
+async function reflow(path, w, h) {
+  await page.setViewportSize({ width: w, height: h })
+  await page.goto(`${BASE}${path}`); await settle()
+  const over = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth)
+  out.reflow.push({ path, width: w, overflow_px: over })
+}
+
+for (const p of PUBLIC) { await tabThrough(p) }
+await page.goto(`${BASE}/login`)
+await page.getByRole('button', { name: /Open demo business/ }).click()
+await page.waitForSelector('text=Do today', { timeout: 20000 })
+for (const p of APP) { await tabThrough(p) }
+for (const p of [...PUBLIC, ...APP]) { await reflow(p, 320, 640); await reflow(p, 720, 450) }
+
+const summary = {
+  routes_tabbed: out.focus.length,
+  tab_stops: out.focus.reduce((n, f) => n + f.stops, 0),
+  routes_with_focus_problems: out.focus.filter((f) => f.problems.length).map((f) => ({ path: f.path, problems: f.problems.slice(0, 6) })),
+  reflow_overflows: out.reflow.filter((r) => r.overflow_px > 0),
+}
+fs.writeFileSync(`${OUT}/keyboard-reflow.json`, JSON.stringify({ summary, ...out }, null, 1))
+console.log(JSON.stringify(summary, null, 1))
+await browser.close()
diff --git a/e2e/audit-speed.mjs b/e2e/audit-speed.mjs
new file mode 100644
index 00000000..0130a3c8
--- /dev/null
+++ b/e2e/audit-speed.mjs
@@ -0,0 +1,39 @@
+// Page speed on a throttled phone profile (4x CPU slowdown, 1.6 Mbps down, 150 ms latency): FCP, LCP, CLS, transferred bytes.
+// Usage: RIPPLE_URL=http://localhost:8769 node audit-speed.mjs <outDir>.  Lighthouse itself was not available, so these are the same metrics read from the browser.
+import { chromium } from 'playwright-core'
+import fs from 'node:fs'
+const BASE = process.env.RIPPLE_URL || 'http://localhost:8000'
+const OUT = process.argv[2] || 'audit-out'
+fs.mkdirSync(OUT, { recursive: true })
+const browser = await chromium.launch({ executablePath: process.env.BROWSER_PATH || 'C:/Program Files/Google/Chrome/Application/chrome.exe', headless: true })
+const ctx = await browser.newContext({ viewport: { width: 390, height: 844 }, deviceScaleFactor: 2 })
+const page = await ctx.newPage()
+const cdp = await ctx.newCDPSession(page)
+await page.addInitScript(() => {
+  window.__m = { lcp: 0, cls: 0 }
+  new PerformanceObserver((l) => { for (const e of l.getEntries()) window.__m.lcp = e.startTime }).observe({ type: 'largest-contentful-paint', buffered: true })
+  new PerformanceObserver((l) => { for (const e of l.getEntries()) if (!e.hadRecentInput) window.__m.cls += e.value }).observe({ type: 'layout-shift', buffered: true })
+})
+const measure = async (path, label) => {
+  await cdp.send('Network.enable'); await cdp.send('Network.emulateNetworkConditions', { offline: false, latency: 150, downloadThroughput: (1.6 * 1024 * 1024) / 8, uploadThroughput: (750 * 1024) / 8 })
+  await cdp.send('Emulation.setCPUThrottlingRate', { rate: 4 })
+  await cdp.send('Network.clearBrowserCache')
+  let bytes = 0
+  page.removeAllListeners('requestfinished')
+  page.on('requestfinished', async (rq) => { try { const z = await rq.sizes(); bytes += z.responseBodySize + z.responseHeadersSize } catch {} })
+  await page.goto(`${BASE}${path}`, { waitUntil: 'networkidle' })
+  await page.waitForTimeout(1500)
+  const m = await page.evaluate(() => ({ ...window.__m, fcp: performance.getEntriesByName('first-contentful-paint')[0]?.startTime || 0 }))
+  await cdp.send('Emulation.setCPUThrottlingRate', { rate: 1 })
+  return { page: label, path, fcp_ms: Math.round(m.fcp), lcp_ms: Math.round(m.lcp), cls: Number(m.cls.toFixed(4)), transferred_kb_on_the_wire: Math.round(bytes / 1024) }
+}
+const rows = [await measure('/login', 'Login (not signed in)')]
+await cdp.send('Emulation.setCPUThrottlingRate', { rate: 1 }); await cdp.send('Network.emulateNetworkConditions', { offline: false, latency: 0, downloadThroughput: -1, uploadThroughput: -1 })
+await page.goto(`${BASE}/login`); await page.getByRole('button', { name: /Open demo business/ }).click(); await page.waitForSelector('text=Do today', { timeout: 20000 })
+rows.push(await measure('/app/today', 'Today (signed in, cold cache)'))
+rows.push(await measure('/app/khata', 'Khata (signed in, cold cache)'))
+rows.push(await measure('/app/settings', 'Settings (signed in, cold cache)'))
+rows.push(await measure('/app/orders', 'Orders (signed in, cold cache)'))
+fs.writeFileSync(`${OUT}/page-speed.json`, JSON.stringify({ profile: '390x844 phone, 4x CPU slowdown, 1.6 Mbps, 150 ms latency, cold cache, localhost server', targets: { lcp_ms: 2500, cls: 0.1 }, rows }, null, 1))
+console.log(JSON.stringify(rows, null, 1))
+await browser.close()
